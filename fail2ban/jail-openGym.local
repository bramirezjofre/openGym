# openGym nginx jail — bans IPs that hit the SPA proxy with too many errors.
#
# Source of truth for the log line: the openGym-web container's stdout, which
# docker ships to a host file via the json-file logging driver (the tag
# "opengym-web" makes the file location stable across container recreates).
# Each line is a JSON envelope, not a raw nginx access line — both jails
# below use the JSON-aware regex defined in nginx-http-opengym.conf.
#
# Two-stage ban:
#   - auth endpoints (/api/register, /api/login) hard-fail fast: 5 fails in
#     10 min → 24h ban. Stops a passkey-enumeration attempt cold.
#   - general 4xx/5xx rate: 30 fails in 10 min → 1h ban. Catches scanners
#     probing for phpinfo / .env / config.json without false-positives on
#     legitimate bad routes.
#
# IMPORTANT: when a jail defines its own failregex, fail2ban creates a
# synthetic filter named after the jail (e.g. opengym-auth) and ignores
# the `filter =` line under [Definition]. The shared filter file
# /etc/fail2ban/filter.d/nginx-http-opengym.conf is therefore used by
# *reference* via `filter =` on each jail — and each jail's own failregex
# overrides it. This is the canonical fail2ban pattern for "one filter,
# many jails with different sensitivities".

[opengym-auth]
# Auth-endpoint failures. 5 in 10 minutes is a clear sign of brute-forcing
# the passkey endpoints — legitimate users hit them once or twice per session.
enabled  = true
filter   = nginx-http-opengym
logpath  = /var/log/openGym/access.log
port     = http,https
findtime = 600
maxretry = 5
bantime  = 86400
# Only count failures against auth-shaped paths. The generic filter
# matches any 4xx/5xx; we tighten here to /api/(register|login) so a SPA
# route refresh that returns 404 doesn't count.
failregex = ^\{"log":"<HOST> - [^"]*"(GET|POST) /(api/register|api/login)[^"]*" (4\d\d|5\d\d)\s

[opengym-scan]
# General scan-style failures. 30 in 10 minutes is generous enough that a
# user mashing broken URLs in dev tools won't trip it, but a script that
# tries a hundred /.env / .php / config.json probes will.
enabled  = true
filter   = nginx-http-opengym
logpath  = /var/log/openGym/access.log
port     = http,https
findtime = 600
maxretry = 30
bantime  = 3600